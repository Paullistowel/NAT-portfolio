# Copy to .env.local (local) or add in your host's dashboard (e.g. Vercel → Settings → Environment Variables).
# Values are read at build time for the page, so redeploy after changing them.

# Public site URL, used for social-sharing images. Optional on Vercel (falls back to the production domain).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form delivery via Resend (https://resend.com). The form stays disabled until both are set.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional. Must be an address on a domain you've verified in Resend. Defaults to Resend's test sender.
CONTACT_FROM_EMAIL=

# Set to "true" to show the dashed [Placeholder] notes in a production build (e.g. on a preview deploy).
NEXT_PUBLIC_SHOW_PLACEHOLDERS=
